#!/sbin/sh

# Manager apps own module installation. KernelSU/APatch use their own
# installer and source customize.sh; this entry is the Magisk bridge.
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }

if [ ! -r /data/adb/magisk/util_functions.sh ]; then
  ui_print "! Install this ZIP from KernelSU, APatch or Magisk while Android is running"
  exit 1
fi
. /data/adb/magisk/util_functions.sh
if ! command -v install_module >/dev/null 2>&1; then
  ui_print "! The manager must provide the install_module installer function"
  exit 1
fi
install_module
